{
    "$schema": "../schema.json",
    "id": "example",
    "name": "Example Extension",
    "version": "1.0.0",
    "api": 1,
    "description": "Adds the recording duration to the notification template.",
    "author": "stream-recorder",
    "main": "main.lua",
    "files": ["main.lua"],
    "hooks": ["after_recording"],
    "permissions": ["session.read"],
    "limits": {
        "timeout_ms": 10000,
        "memory_mb": 32
    },
    "settings": {
        "label": {
            "type": "string",
            "default": "Duration",
            "description": "Label used in the log message"
        }
    }
}
